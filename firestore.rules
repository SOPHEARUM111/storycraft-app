rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;

      match /dailyUsage/{dateKey} {
        // Usage/quota documents are server-managed; use callable functions to read them.
        allow read, write: if false;
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'userId', 'title', 'tone', 'targetMinutes', 'status',
          'processingStep', 'processingProgress', 'createdAt',
          'updatedAt', 'errorMessage'
        ])
        && request.resource.data.status == 'draft'
        && request.resource.data.targetMinutes is int
        && request.resource.data.targetMinutes >= 1
        && request.resource.data.targetMinutes <= 90
        && request.resource.data.processingProgress == 0;

      // Only editable metadata is writable by the app. Upload paths, scripts,
      // processing state, quota, and generated assets are server-managed.
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'tone'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200;

      allow delete: if false;
    }

    match /storyJobs/{jobId} {
      allow read: if signedIn() && request.auth.token.admin == true;
      allow create, update, delete: if false;
    }

    match /adminAuditLogs/{logId} {
      allow read, write: if false;
    }

    match /adminAlerts/{alertId} {
      allow read, write: if false;
    }

    match /adminDevices/{uid}/tokens/{tokenId} {
      allow read, write: if false;
    }
  }
}
